# En desarrollo, Vite ya proxea /api y /socket.io al backend (ver vite.config.js),
# asi que estas variables pueden quedar vacias y todo funciona igual.
#
# En produccion normalmente tambien quedan vacias: el build estatico lo sirve
# Nginx desde el mismo dominio que el backend, y /api queda resuelto por el
# proxy_pass de Nginx (mismo origen, sin CORS). Completalas solo si el
# frontend y el backend van a vivir en dominios distintos.

VITE_API_URL=
VITE_SOCKET_URL=
