# Copia de referencia: NUNCA pongas los valores reales acá.
# Los valores reales se cargan en el panel de variables del hosting.

# --- WhatsApp (Meta) · docs/1-whatsapp-meta.md ---
WHATSAPP_TOKEN=pegá-acá-el-token-permanente
WHATSAPP_PHONE_NUMBER_ID=123456789012345
WHATSAPP_VERIFY_TOKEN=una-frase-que-inventes-vos
WHATSAPP_APP_SECRET=clave-secreta-de-la-app
# Números que pueden usar el bot, separados por coma, con código de país y sin "+"
NUMEROS_AUTORIZADOS=5491144367063

# --- Bot ---
# Dirección pública del bot (sin barra al final)
URL_PUBLICA=https://bot-bairesfly.up.railway.app
# Contraseña que inventás vos para las páginas de administración (/google/conectar)
CLAVE_ADMIN=una-clave-larga-que-inventes
TZ=America/Argentina/Buenos_Aires

# --- Google · docs/3-google.md ---
GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxx
GOOGLE_REFRESH_TOKEN=se-obtiene-entrando-a-/google/conectar

# --- Claude · docs/4-claude.md ---
ANTHROPIC_API_KEY=sk-ant-xxxx

# --- Avisos · docs/5-avisos.md ---
PLANTILLA_AVISO=aviso_vencimiento
PLANTILLA_IDIOMA=es_AR

# --- Opcionales (ya tienen un valor por defecto) ---
