# Copiar este archivo a .env y completar con los valores reales.
# NUNCA commitear el archivo .env con datos reales.

# Conexion a PostgreSQL
DATABASE_URL=postgresql://comandy_user:CAMBIAR_PASSWORD@localhost:5432/comandy_db

# Secreto para firmar los JWT (generar uno fuerte, ej: openssl rand -hex 64)
JWT_SECRET=CAMBIAR_ESTE_SECRETO_POR_UNO_ALEATORIO_LARGO
JWT_EXPIRES_IN=8h

# Puerto donde escucha la API (Nginx hace proxy_pass a este puerto)
PORT=5000

# Entorno: development | production
NODE_ENV=production

# URL del frontend, usada para configurar CORS
FRONTEND_URL=https://comandy.com.ar

# Carpeta donde se escriben los logs (requiere que exista y tenga permisos)
LOG_DIR=/var/log/comandy
